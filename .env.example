# Manus provides these server-side runtime values in managed development/deployment.
# For independent deployment, obtain service credentials and keep them server-only.
MANUS_API_URL=
MANUS_API_KEY=
DATABASE_URL=

# Public API origin embedded in native builds. Empty for same-origin web deployment.
# Native builds need an HTTPS backend origin reachable by the iPad/phone.
EXPO_PUBLIC_API_BASE_URL=

# Optional exact canonical origin for reverse proxies or browsers without Fetch Metadata.
# Example format: https://your-web-app.example (no trailing slash or path).
PUBLIC_WEB_ORIGIN=

# Production backend listener; managed mobile development uses 3000.
PORT=3000
NODE_ENV=production

# Optional stencil workflow overrides (see workflows/stencil.config.json).
# Do not change mirror behaviour: each output is mirrored exactly once.
STENCIL_THRESHOLD=180
STENCIL_MIN_COMPONENT_PIXELS=3
